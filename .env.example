# Copy to .env.local and fill in. Never commit the filled-in file.

# Gmail account that sends contact form messages
GMAIL_USER=you@gmail.com

# Google App Password (not your account password).
# Generate at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Public site URL, used for metadata, sitemap and robots.
# On Vercel this falls back to the deployment URL if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
